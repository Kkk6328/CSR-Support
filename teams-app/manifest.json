{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "OMNIPLAY",
    "websiteUrl": "https://gb168168.github.io/OMNIPLAY-CSR-Support/",
    "privacyUrl": "https://gb168168.github.io/OMNIPLAY-CSR-Support/",
    "termsOfUseUrl": "https://gb168168.github.io/OMNIPLAY-CSR-Support/"
  },
  "name": {"short": "OMNIPLAY CSR Support", "full": "OMNIPLAY CSR Support Conversation Bot"},
  "description": {
    "short": "將 Teams 訊息送入 OMNIPLAY Conversation 收件匣",
    "full": "收集客服手動傳送的文字與附件；輸入執行後建立統一 Conversation。不執行 AI 分析。"
  },
  "icons": {"outline": "outline.png", "color": "color.png"},
  "accentColor": "#2563EB",
  "bots": [{
    "botId": "{{TEAMS_APP_ID}}",
    "scopes": ["personal", "team", "groupChat"],
    "supportsFiles": true,
    "isNotificationOnly": false
  }],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["asia-east1-{{FIREBASE_PROJECT_ID}}.cloudfunctions.net"]
}
